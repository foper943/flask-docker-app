# ============================================================
# Пример конфигурации окружения — скопируй в .env и заполни
# ============================================================

# --- Flask приложение ---
PORT=5000
DEBUG=False
SECRET_KEY=замените-на-случайную-строку-32-символа
SERVICE_NAME=app
APP_VERSION=dev

# --- База данных PostgreSQL ---
# Используй DATABASE_URL (приоритет) или отдельные переменные
DATABASE_URL=postgresql://postgres:postgres@db:5432/mydb

# Отдельные переменные (альтернатива DATABASE_URL)
DB_HOST=db
DB_PORT=5432
DB_NAME=mydb
DB_USER=postgres
DB_PASSWORD=postgres

# --- Redis ---
# Используй REDIS_URL (приоритет) или REDIS_HOST
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis

# --- Docker ---
DOCKER_USERNAME=your-docker-username
IMAGE_TAG=latest

# --- GitHub Actions (задаются как Secrets в репозитории) ---
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# REDIS_URL=redis://host:6379/0
# STAGING_HOST=your-server-ip
# STAGING_USER=ubuntu
# STAGING_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----...
